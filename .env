# =============================================================================
# THRONOS VERIFYID — PRODUCTION ENV
# Railway service: thronos-verifyid  |  Region: us-east4
# Generated: 2026-02-28
#
# AI CALLS: no LLM provider keys here.
# All inference goes through thronos-V3.6 core node (APP_AI_BASE_URL below).
# thronos-V3.6 exposes /v1/chat/completions (OpenAI-compat) + /api/v1/fraud/document
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# DATABASE — set this in Railway's Variables dashboard (Postgres plugin).
# DO NOT change this value; Railway injects DATABASE_URL automatically.
# Remove this line if Railway already sets DATABASE_URL via plugin.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@postgres.railway.internal:5432/verifyid

# ---------------------------------------------------------------------------
# JWT (HS256) — used for agent/client session tokens
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=1c777c187b6ea00700c85c3b406f2172ce5087070b5a0c3ca919707aac7a9b095cd94c754c9ab57bafa6d00a833db486
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# KYC AUTH
# ---------------------------------------------------------------------------
KYC_AUTH_MODE=internal
KYC_ADMIN_KEY=kyc_be34e36993768719d02acf2714402c1cf01c302b6a179aca

# ---------------------------------------------------------------------------
# THRONOS CHAIN ADMIN
# ---------------------------------------------------------------------------
THRONOS_ADMIN_SECRET=edecfdadeed393b7f441449b0c22dccb83ff53ebda145e4fa4505e09bf174724

# ---------------------------------------------------------------------------
# JWT CROSS-APP CLAIMS (for CareerForge SSO cross-link tokens)
# Normal verifyid tokens use aud=verifyid internally.
# The /api/v1/auth/careerforge-link endpoint issues aud=careerforge tokens.
# ---------------------------------------------------------------------------
JWT_ISSUER=https://gateway.thronoschain.org
JWT_AUDIENCE=careerforge
CAREERFORGE_UI_URL=https://careerforge.thronoschain.org

# ---------------------------------------------------------------------------
# AI CORE — thronos-V3.6 main node (LLM keys live there, not here)
#
# APP_AI_BASE_URL → /v1/chat/completions proxy on thronos-V3.6 (OpenAI SDK)
# THRONOS_AI_CORE_URL → direct calls (fraud doc, assistant ask, agent chat)
# APP_AI_KEY / THRONOS_AI_INTERNAL_KEY → shared secret (same as V3.6 APP_AI_KEY)
# ---------------------------------------------------------------------------
APP_AI_BASE_URL=https://thronos-core.up.railway.app
APP_AI_KEY=thr_ai_9de93a04192f8fb2b7c00f088832465d6d586b43d768bd92673a39f1
THRONOS_AI_CORE_URL=https://thronos-core.up.railway.app
THRONOS_AI_INTERNAL_KEY=thr_ai_9de93a04192f8fb2b7c00f088832465d6d586b43d768bd92673a39f1

# ---------------------------------------------------------------------------
# THRONOS CHAIN NODE URLS
# ---------------------------------------------------------------------------
THRONOS_NODE1_URL=https://api.thronoschain.org
THRONOS_NODE2_URL=https://node2.thronoschain.org
THRONOS_CDN_URL=https://thrchain.vercel.app

# ---------------------------------------------------------------------------
# CORS (Railway + Vercel frontend)
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=https://verifyid.thronoschain.org,https://thronos-verifyid.vercel.app,https://thronos-verifyid.up.railway.app

# ---------------------------------------------------------------------------
# EMAIL (leave disabled — configure SMTP when ready)
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=noreply@thronoschain.org
EMAIL_FROM_NAME=Thronos VerifyID
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# STRIPE (leave empty — add after service boots correctly)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AWS LAMBDA (false for Railway)
# ---------------------------------------------------------------------------
IS_LAMBDA=false
