# =============================================================================
# THRONOS VERIFYID — PRODUCTION ENV
# Railway service: thronos-verifyid  |  Region: us-east4
# Generated: 2026-02-28
#
# AI CALLS: this service NEVER holds LLM keys.
# All AI inference goes through thronos-V3.6 (THRONOS_AI_CORE_URL below).
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# DATABASE — Railway Postgres plugin (add plugin → copy DATABASE_URL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:REPLACE_WITH_RAILWAY_POSTGRES_PASSWORD@postgres.railway.internal:5432/verifyid

# SQLite fallback (dev only — not suitable for production KYC data)
# DATABASE_URL=sqlite+aiosqlite:///verifyid.db

# ---------------------------------------------------------------------------
# JWT (HS256 — used for agent session tokens)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=1c777c187b6ea00700c85c3b406f2172ce5087070b5a0c3ca919707aac7a9b095cd94c754c9ab57bafa6d00a833db486
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# KYC AUTH
# ---------------------------------------------------------------------------
KYC_AUTH_MODE=internal
KYC_ADMIN_KEY=kyc_be34e36993768719d02acf2714402c1cf01c302b6a179aca

# ---------------------------------------------------------------------------
# THRONOS CHAIN ADMIN
# ---------------------------------------------------------------------------
THRONOS_ADMIN_SECRET=edecfdadeed393b7f441449b0c22dccb83ff53ebda145e4fa4505e09bf174724

# ---------------------------------------------------------------------------
# AI CORE — points to thronos-V3.6 main node (NOT to Render, NOT direct LLM)
# verifyid calls:
#   POST /api/chat           (KYC agent dashboard chat)
#   POST /api/v1/fraud/document  (document fraud analysis)
#   POST /api/v1/assistant/ask   (general agent assistant)
# The X-Internal-Key header must carry APP_AI_KEY (same value as thronos-V3.6)
# ---------------------------------------------------------------------------
THRONOS_AI_CORE_URL=https://thronos-core.up.railway.app
APP_AI_KEY=thr_ai_9de93a04192f8fb2b7c00f088832465d6d586b43d768bd92673a39f1

# Internal URL alias (used by ai_chat.py)
THRONOS_AI_INTERNAL_KEY=thr_ai_9de93a04192f8fb2b7c00f088832465d6d586b43d768bd92673a39f1

# ---------------------------------------------------------------------------
# THRONOS CHAIN NODE URLS
# ---------------------------------------------------------------------------
THRONOS_NODE1_URL=https://thronos-core.up.railway.app
THRONOS_NODE2_URL=https://node2.thronoschain.org
THRONOS_CDN_URL=https://thrchain.vercel.app

# ---------------------------------------------------------------------------
# CORS (add your frontend domain)
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=https://verifyid.thronoschain.org,https://thrchain.vercel.app

# ---------------------------------------------------------------------------
# EMAIL (leave disabled until you configure an SMTP provider)
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@thronoschain.org
EMAIL_FROM_NAME=Thronos VerifyID
EMAIL_REPLY_TO=support@thronoschain.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SALES_INBOX_EMAIL=sales@thronoschain.org

# ---------------------------------------------------------------------------
# STRIPE (leave empty — add keys once service boots correctly)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# AWS LAMBDA (set to false for Railway deployment)
# ---------------------------------------------------------------------------
IS_LAMBDA=false
